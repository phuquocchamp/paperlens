  "cards": [
    {
      "dot": "cyan",
      "title": "Query path (api)",
      "items": [
        "Browser → BFF → FastAPI; the browser never calls the backend",
        "Dense + sparse prefetch, explicit-k RRF, per-document quota",
        "Abstain gate on top dense cosine returns zero citations"
      ]
    },
    {
      "dot": "emerald",
      "title": "Ingestion path (worker)",
      "items": [
        "One ARQ job: parse → crop → caption → chunk → embed → index",
        "TEXT_READY once text is embedded, then FULL_READY after captions",
        "Cron: stuck sweep every 10 min, corpus reconcile nightly at 03:00"
      ]
    },
    {
      "dot": "rose",
      "title": "Boundaries",
      "items": [
        "app/rag is imported by both entrypoints — only it touches Qdrant",
        "The ARQ task owns every documents-table write",
        "Only api and frontend publish host ports; no auth in v1"
      ]
    }
  ]
