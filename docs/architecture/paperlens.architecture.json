        "id": "ingest-path",
        "label": "Ingestion path",
        "focus": [
          "api",
          "redis",
          "worker",
          "appdata",
          "openai",
          "qdrant"
        ],
        "note": "Upload is enqueued on Redis and drained by the ARQ worker, which owns every documents-table write."
      },
      {
        "id": "state",
        "label": "Durable state",
        "focus": [
          "postgres",
          "qdrant",
          "redis",
          "appdata"
        ],
        "note": "Postgres is the source of truth, Qdrant holds vectors, Redis is queue plus caches, the volume holds bytes."
      }
    ]
