# PaperLens environment — copy to .env and fill in secrets: `cp .env.example .env`
#
# Every variable read by backend/app/config.py can be set here (pydantic-settings
# maps field names case-insensitively). Connection strings, secrets, provider and
# storage settings are listed live below. The tuning constants (chunking,
# retrieval, rate limits, timeouts…) keep their defaults in app/config.py — the
# single source of truth — and are shown COMMENTED OUT at the bottom; uncomment a
# line only to deliberately override the default.

# ── Infrastructure connections ───────────────────────────
# Defaults target the Compose service names; override for a non-Compose run.
DATABASE_URL="postgresql+asyncpg://paperlens:paperlens@postgres:5432/paperlens"
REDIS_URL="redis://redis:6379/0"
QDRANT_URL="http://qdrant:6333"
QDRANT_COLLECTION_ALIAS="chunks"

# ── Storage volume (uploads/ · figures/ · models/) ───────
DATA_DIR="/data"
HF_HOME="/data/models"          # Docling / HuggingFace model cache

# ── LLM / embedding providers ────────────────────────────
OPENAI_API_KEY="your_openai_api_key"          # embeddings + OpenAI fallback LLM
DEEPSEEK_API_KEY="your_deepseek_api_key"      # default chat LLM
DEEPSEEK_BASE_URL="https://api.deepseek.com"
LLM_MODEL_DEFAULT="deepseek-chat"
LLM_MODEL_FALLBACK="gpt-4o-mini"

# ── Langfuse (optional observability, wired at P2) ───────
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_HOST="https://cloud.langfuse.com"

# ── Worker sizing (operational knobs) ────────────────────
WORKER_MAX_JOBS="1"             # one Docling ingest per worker at v1
OMP_NUM_THREADS="1"             # 1 not 2: Docling drops text with 2 (P1 finding)

# ─────────────────────────────────────────────────────────
# Tuning constants — defaults live in app/config.py (source of truth).
# Uncomment to override a specific value; leave commented to inherit the default.
# ─────────────────────────────────────────────────────────
# Chunking
#CHUNK_TARGET="900"
#CHUNK_MAX="1200"
#CHUNK_OVERLAP="130"
#CHUNK_MIN_MERGE="120"
# Embedding & sparse
#EMBEDDING_MODEL="text-embedding-3-large"
#EMBEDDING_DIMS="1024"
#BM25_AVG_LEN=            # CALIBRATE (P1) — measured from the real corpus
# Retrieval / fusion
#PREFETCH_DENSE="40"
#PREFETCH_SPARSE="40"
#RRF_K="10"
#FUSED_TOP_K="20"
#PER_DOC_QUOTA="4"
#CONTEXT_TOP_K="8"
#FUSION_WEIGHT_ORIGINAL="0.6"
#FUSION_WEIGHT_REWRITE="0.4"
#OFFTOPIC_METRIC="max_dense_cosine"
#OFFTOPIC_THRESHOLD=      # CALIBRATE (end P2) from a calibration file
# Figures
#MAX_FIGURES_IN_CONTEXT="4"
#FIGURE_CANDIDATE="6"
#FIG_SCORE_FLOOR_FACTOR="0.7"
#CAPTION_CONCURRENCY="2"
# Streaming / citation markers — MUST match the client (see CONTRACT.md §3)
#MAX_HOLD="24"
# Parsing
#MAX_PAGES="80"
#DO_OCR="true"
#TABLEFORMER_MODE="ACCURATE"
#IMAGES_SCALE="2.0"
#TEXT_YIELD_GATE="200"
# Rate limiting & cost cap
#RATE_LIMIT_MESSAGES="20"
#RATE_LIMIT_MESSAGES_WINDOW_S="600"
#RATE_LIMIT_UPLOADS="10"
#RATE_LIMIT_UPLOADS_WINDOW_S="3600"
#DAILY_COST_CAP_USD="5.0"
# History truncation
#HISTORY_MAX_TURNS="6"
#HISTORY_MAX_TOKENS="2000"
# Timeouts
#SWEEP_STUCK_AFTER_MINUTES="45"
#STOP_FLAG_TTL_S="600"
